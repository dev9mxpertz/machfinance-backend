NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/machfinance

# Use a long random string in every non-local environment
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=8h

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Optional: fixed base32 TOTP secret for the seeded demo user (random if empty)
DEMO_TOTP_SECRET=

# Lets test accounts created with "npm run create-test-user" log in with a fixed code.
# Never enable this in production.
ALLOW_STATIC_TOTP=false

# Market data: "yahoo" = live NSE prices from Yahoo Finance (free, no key, may be delayed),
# "simulated" = offline model. Option premiums/OI are always modelled from the spot price.
MARKET_DATA_SOURCE=yahoo
